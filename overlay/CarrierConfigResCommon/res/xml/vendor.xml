<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<carrier_config_list>
    <carrier_config>
        <!-- Initial userspace MMTEL scope. -->
        <boolean name="carrier_volte_available_bool" value="true" />
        <boolean name="carrier_vt_available_bool" value="false" />
        <boolean name="imssms.sms_over_ims_supported_bool" value="true" />

        <!-- Make WFC availability deterministic. -->
        <boolean name="carrier_wfc_ims_available_bool" value="true" />
        <boolean name="carrier_wfc_supports_wifi_only_bool" value="true" />
        <boolean name="carrier_default_wfc_ims_enabled_bool" value="true" />
        <int name="carrier_default_wfc_ims_mode_int" value="2" />

        <!-- The legacy data HAL cannot add the MMTEL network capability. -->
        <boolean name="ims.request_ims_pdn_without_mmtel_bool" value="true" />

        <!-- The open ImsMedia implementation has no EVS codec. -->
        <boolean name="imsvoice.audio_evs_support_bool" value="false" />

        <!-- Exclude AES-XCBC-96 from the IWLAN Child SA proposal. -->
        <int-array name="iwlan.supported_integrity_algorithms_int_array" num="4">
            <item value="2" />
            <item value="12" />
            <item value="13" />
            <item value="14" />
        </int-array>

        <!-- The legacy data HAL needs break-before-make IMS switching. -->
        <boolean name="delay_ims_tear_down_until_call_end_bool" value="true" />

        <string-array name="iwlan_handover_policy_string_array" num="5">
            <item value="source=EUTRAN|NGRAN, target=IWLAN, type=disallowed, capabilities=IMS|EIMS" />
            <item value="source=IWLAN, target=EUTRAN|NGRAN, type=disallowed, capabilities=IMS|EIMS" />
            <item value="source=IWLAN, target=GERAN|UTRAN, type=disallowed" />
            <item value="source=GERAN|UTRAN, target=IWLAN, type=disallowed" />
            <item value="source=GERAN|UTRAN|EUTRAN|NGRAN|IWLAN|UNKNOWN, target=GERAN|UTRAN|EUTRAN|NGRAN|IWLAN, type=allowed" />
        </string-array>
    </carrier_config>

    <!-- MEDIONmobile / o2 DE -->
    <carrier_config cid="1453" name="medionmobile">
        <boolean name="enable_carrier_display_name_resolver_bool" value="true" />
    </carrier_config>
</carrier_config_list>
