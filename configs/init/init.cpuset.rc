on early-init
    # Ensure mountpoint exists, then try cpuset mount
    mkdir /dev/cpuset 0755 root root
    mount cgroup none /dev/cpuset cpuset

# Write masks only after nodes are present
on late-init
    # Wait up to 10s for the cpuset interface to appear
    wait /dev/cpuset/cpuset.cpus 10
    wait /dev/cpuset/cpuset.mems 10

    # NUMA: Exynos9810 is single node => mems=0 everywhere
    write /dev/cpuset/cpuset.mems 0
    write /dev/cpuset/cpuset.cpus 0-7
    write /dev/cpuset/sched_load_balance 1

    # Ensure children exist
    mkdir /dev/cpuset/top-app 0755 system system
    mkdir /dev/cpuset/foreground 0755 system system
    mkdir /dev/cpuset/foreground/boost 0755 system system
    mkdir /dev/cpuset/background 0755 system system
    mkdir /dev/cpuset/system-background 0755 system system
    mkdir /dev/cpuset/restricted 0755 system system
    mkdir /dev/cpuset/camera-daemon 0755 system system

    # Set children: mems first, then cpus, then load_balance
    write /dev/cpuset/top-app/cpuset.mems 0
    write /dev/cpuset/top-app/cpuset.cpus 0-7
    write /dev/cpuset/top-app/sched_load_balance 1

    write /dev/cpuset/foreground/cpuset.mems 0
    write /dev/cpuset/foreground/cpuset.cpus 0-7
    write /dev/cpuset/foreground/sched_load_balance 1

    write /dev/cpuset/foreground/boost/cpuset.mems 0
    write /dev/cpuset/foreground/boost/cpuset.cpus 4-7
    write /dev/cpuset/foreground/boost/sched_load_balance 1

    write /dev/cpuset/system-background/cpuset.mems 0
    write /dev/cpuset/system-background/cpuset.cpus 0-3
    write /dev/cpuset/system-background/sched_load_balance 1

    write /dev/cpuset/background/cpuset.mems 0
    write /dev/cpuset/background/cpuset.cpus 0-3
    write /dev/cpuset/background/sched_load_balance 1

    write /dev/cpuset/restricted/cpuset.mems 0
    write /dev/cpuset/restricted/cpuset.cpus 0-3
    write /dev/cpuset/restricted/sched_load_balance 1

    write /dev/cpuset/camera-daemon/cpuset.mems 0
    write /dev/cpuset/camera-daemon/cpuset.cpus 0-7
    write /dev/cpuset/camera-daemon/sched_load_balance 1

    # Root aliases
    symlink /dev/cpuset/cpuset.cpus /dev/cpuset/cpus
    symlink /dev/cpuset/cpuset.mems /dev/cpuset/mems

    # Group aliases
    symlink /dev/cpuset/top-app/cpuset.cpus           /dev/cpuset/top-app/cpus
    symlink /dev/cpuset/top-app/cpuset.mems           /dev/cpuset/top-app/mems
    symlink /dev/cpuset/foreground/cpuset.cpus        /dev/cpuset/foreground/cpus
    symlink /dev/cpuset/foreground/cpuset.mems        /dev/cpuset/foreground/mems
    symlink /dev/cpuset/foreground/boost/cpuset.cpus  /dev/cpuset/foreground/boost/cpus
    symlink /dev/cpuset/foreground/boost/cpuset.mems  /dev/cpuset/foreground/boost/mems
    symlink /dev/cpuset/foreground_window/cpuset.cpus /dev/cpuset/foreground_window/cpus
    symlink /dev/cpuset/foreground_window/cpuset.mems /dev/cpuset/foreground_window/mems
    symlink /dev/cpuset/background/cpuset.cpus        /dev/cpuset/background/cpus
    symlink /dev/cpuset/background/cpuset.mems        /dev/cpuset/background/mems
    symlink /dev/cpuset/system-background/cpuset.cpus /dev/cpuset/system-background/cpus
    symlink /dev/cpuset/system-background/cpuset.mems /dev/cpuset/system-background/mems
    symlink /dev/cpuset/restricted/cpuset.cpus        /dev/cpuset/restricted/cpus
    symlink /dev/cpuset/restricted/cpuset.mems        /dev/cpuset/restricted/mems
    symlink /dev/cpuset/camera-daemon/cpuset.cpus     /dev/cpuset/camera-daemon/cpus
    symlink /dev/cpuset/camera-daemon/cpuset.mems     /dev/cpuset/camera-daemon/mems

    # Allow system to move tasks
    chown system system /dev/cpuset/tasks
    chmod 0664 /dev/cpuset/tasks
    chown system system /dev/cpuset/top-app/tasks
    chmod 0664 /dev/cpuset/top-app/tasks
    chown system system /dev/cpuset/foreground/tasks
    chmod 0664 /dev/cpuset/foreground/tasks
    chown system system /dev/cpuset/foreground/boost/tasks
    chmod 0664 /dev/cpuset/foreground/boost/tasks
    chown system system /dev/cpuset/background/tasks
    chmod 0664 /dev/cpuset/background/tasks
    chown system system /dev/cpuset/system-background/tasks
    chmod 0664 /dev/cpuset/system-background/tasks
    chown system system /dev/cpuset/restricted/tasks
    chmod 0664 /dev/cpuset/restricted/tasks
    chown system system /dev/cpuset/camera-daemon/tasks
    chmod 0664 /dev/cpuset/camera-daemon/tasks
