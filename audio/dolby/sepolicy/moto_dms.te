# SPDX-License-Identifier: Apache-2.0
# Only the vendor effect HAL talks to DMS; the settings APK uses AudioEffect, not HwBinder.
hal_attribute(moto_dms)

type hal_moto_dms_default, domain;
hal_server_domain(hal_moto_dms_default, hal_moto_dms)
type hal_moto_dms_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_moto_dms_default)
hwbinder_use(hal_moto_dms_default)

type hal_moto_dms_hwservice, hwservice_manager_type, protected_hwservice;
hal_attribute_hwservice(hal_moto_dms, hal_moto_dms_hwservice)
hal_client_domain(hal_audio_default, hal_moto_dms)
binder_call(hal_moto_dms_client, hal_moto_dms_server)
binder_call(hal_moto_dms_server, hal_moto_dms_client)

# Configuration is read-only; the private database is owned solely by DMS.
type vendor_moto_dms_data_file, file_type, data_file_type;
allow hal_moto_dms_default vendor_data_file:dir search;
allow hal_moto_dms_default vendor_configs_file:dir r_dir_perms;
allow hal_moto_dms_default vendor_configs_file:file r_file_perms;
allow hal_moto_dms_default vendor_moto_dms_data_file:dir create_dir_perms;
allow hal_moto_dms_default vendor_moto_dms_data_file:file create_file_perms;

# Vendor init applies the two false defaults from PRODUCT_VENDOR_PROPERTIES.
# The audio HAL only reads them; the app and untrusted domains get no write access.
vendor_internal_prop(vendor_moto_dms_debug_prop)
set_prop(vendor_init, vendor_moto_dms_debug_prop)
get_prop(hal_audio_default, vendor_moto_dms_debug_prop)
