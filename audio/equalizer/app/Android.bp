android_app {
    name: "Exynos9810OutputEqualizer",
    defaults: ["SettingsLibDefaults"],
    srcs: ["src/**/*.java"],
    platform_apis: true,
    static_libs: ["androidx.preference_preference"],
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    required: ["exynos9810_output_equalizer_permissions"],
}

prebuilt_etc {
    name: "exynos9810_output_equalizer_permissions",
    src: "privapp-permissions-org.lineageos.audio.equalizer.xml",
    filename_from_src: true,
    sub_dir: "permissions",
    system_ext_specific: true,
}
