android_app_import {
    name: "SamsungCameraExynos9810",
    apk: "//device/samsung/exynos9810-common:SamsungCameraExynos9810Apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    optional_uses_libs: ["org.apache.http.legacy"],
    enforce_uses_libs: true,
    dex_preopt: {
        enabled: false,
    },
}

// SPDX-License-Identifier: Apache-2.0
// Copyright (C) 2026 The LineageOS Project

cc_prebuilt_library_shared {
    name: "libSamsungCameraSecImaging",
    owner: "samsung",
    srcs: [":exynos9810_stock_camera_secimaging_blob"],
    stem: "libsecimaging.camera.samsung",
    compile_multilib: "64",
    system_ext_specific: true,
    stl: "none",
    strip: {
        none: true,
    },
    prefer: true,
    check_elf_files: true,
    shared_libs: [
        "libnativehelper_compat_libc++",
        "libcutils",
        "libutils",
        "libbinder",
        "libandroid_runtime",
        "libjpeg",
        "liblog",
        "libz",
        "libSamsungCameraExif",
        "libSamsungCameraJpeg",
        "libGLESv2",
        "libEGL",
        "libgui",
        "libSamsungCameraJpegInterface",
        "libandroid",
        "libui",
        "libjnigraphics",
        "libSamsungCameraCore",
        "libpng",
        "libaudioclient",
        "libmedia",
        "libstagefright_foundation",
        "libstagefright",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
}

